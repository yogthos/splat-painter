...  789 ;; --- BLOG ABLATIONS (scratch worktree only, not for merge) -------------------
...  790 ;; Each flag rewinds ONE idea out of the shader so the blog post can show what the
...  791 ;; painting looks like without it. Off by default = the shipped shader, byte-identical.
...  792 (def ^:private abl-round?   (some? (System/getenv "SP_ABL_ROUND")))   ; no structure tensor: round, axis-aligned dabs
...  793 (def ^:private abl-grid?    (some? (System/getenv "SP_ABL_GRID")))    ; stratified lattice instead of hashed positions
...  794 (def ^:private abl-nowav?   (some? (System/getenv "SP_ABL_NOWAV")))   ; density ignores the wavelet detail map
...  795 (def ^:private abl-nolayer? (some? (System/getenv "SP_ABL_NOLAYER"))) ; no underpainting/glaze ladder: every stroke opaque, own colour
...  796 
...  797 (def ^:private grid-src
...  798   "  // ABLATION: regular stratified lattice (the thing hashing replaced). The level
...  799   // carries nx candidates (ny = 1), so lay them out as an aspect-matched grid.
...  800   int NTOT = max(1, u_nx[k] * u_ny[k]);
...  801   int gw = max(1, int(floor(sqrt(float(NTOT) * float(u_W) / float(u_H)) + 0.5)));
...  802   int gh = max(1, (NTOT + gw - 1) / gw);
...  803   int gi = local / gw, gj = local - gi * gw;
...  804   float cx = (float(gi) + 0.5) * float(u_H) / float(gh);
...  805   float cy = (float(gj) + 0.5) * float(u_W) / float(gw);")
...  806 
...  807 (defn- ablate [src]
...  808   (cond-> src
...  809     abl-round?
...  810     (-> (clojure.string/replace "float se  = (selong > 0.0) ? selong : sqrt(e);"
...  811                                 "float se  = 1.0;   // ABLATION: no tensor elongation")
...  812         (clojure.string/replace "float c = cos(theta), s = sin(theta);"
...  813                                 "float c = 1.0, s = 0.0;   // ABLATION: no tensor orientation"))
...  814     abl-grid?
...  815     (clojure.string/replace
...  816       (str "  float cx = float(u_H) * poshash(i, lvl, 29);\n"
...  817            "  float cy = float(u_W) * poshash(i, lvl, 31);")
...  818       grid-src)
...  819     ;; the level ladder, budget and sizes stay exactly as they are — only the
...  820     ;; question "does a stroke go HERE?" stops consulting the detail map: every
...  821     ;; level paints its whole candidate set, so density is flat across the canvas
...  822     ;; instead of following the texture.
...  823     abl-nowav?
...  824     (-> (clojure.string/replace
...  825           "float dv = mapAt(u_sharp[k], cx, cy);"
...  826           "float dv = 1.0;   // ABLATION: no detail map — every level paints everywhere")
...  827         (clojure.string/replace
...  828           "float fdv = mapAt(u_sharp[k-1], cx, cy) * (0.25 + 0.75 * sgate) * bgate;"
...  829           "float fdv = 0.0;   // ABLATION: no subdivision handoff")
...  830         (clojure.string/replace
...  831           "float gain = (lvl >= 2) ? (0.25 + 0.75 * sgate) * bgate : (lvl == 1) ? bgate : 1.0;"
...  832           "float gain = 1.0;   // ABLATION: no subjectness gate"))
...  833     ;; before the layering idea there was no underpainting and no glaze ladder:
...  834     ;; every stroke was opaque and painted the colour under its own position.
...  835     abl-nolayer?
...  836     (-> (clojure.string/replace
...  837           "float hb = (lvl <= 1) ? 1.0 : 0.0;"
...  838           "float hb = 0.0;   // ABLATION: no heavy-blur underpainting")
...  839         (clojure.string/replace
...  840           "float traw = (lvl <= 1) ? 0.0 : (ssz2 < 1.5) ? 0.85 : (ssz2 < 3.5) ? 0.7 : (ssz2 < 8.0) ? 0.45 : 0.0;"
...  841           "float traw = 0.7;   // ABLATION: same colour fidelity at every scale")
...  842         (clojure.string/replace
...  843           "float tcap = (lvl <= 1) ? 0.35 : (ssz2 < 3.5) ? 1.0 : (ssz2 < 8.0) ? 0.7 : 0.35;"
...  844           "float tcap = 1.0;   // ABLATION")
...  845         (clojure.string/replace
...  846           "float tcap2 = min(tcap, 0.3 + 0.7 * min(1.0, 3.0 / max(csz, 1e-6)));"
...  847           "float tcap2 = tcap;   // ABLATION")
...  848         (clojure.string/replace
...  849           "float lal = (band || lvl <= 1) ? 1.0 : (ssz2 >= 8.0) ? 1.0 : 0.85;"
...  850           "float lal = 1.0;   // ABLATION: no glazing, every layer opaque"))))
